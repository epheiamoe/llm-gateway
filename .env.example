PORT=3456
ADMIN_KEY=change-me-in-production

# OpenCode GO pass-through configuration
# OPENCODE_GO_FALLBACK_MODEL must match a Model created in the gateway UI.
# All unknown model names will be routed through this fallback model while
# preserving the original model name in upstream requests.
OPENCODE_GO_FALLBACK_MODEL=opencode-go

# Comma-separated list of real OpenCode GO model IDs advertised via /v1/models.
# These IDs must match the names OpenCode GO expects in the request body.
OPENCODE_GO_MODELS=glm-5.2,glm-5.1,kimi-k2.7-code,kimi-k2.6,mimo-v2.5,mimo-v2.5-pro,minimax-m3,minimax-m2.7,qwen3.7-max,qwen3.7-plus,qwen3.6-plus,deepseek-v4-pro,deepseek-v4-flash

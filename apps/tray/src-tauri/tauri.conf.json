{
  "productName": "LLM Gateway Tray",
  "version": "2.0.2",
  "identifier": "moe.epheia.llm-gateway-tray",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "status",
        "create": false,
        "title": "LLM Gateway Tray",
        "width": 360,
        "height": 320,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [
      "icons/icon-green.png",
      "icons/icon-red.png",
      "icons/icon-yellow.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
